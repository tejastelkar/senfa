# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Credentials come from the "Senfa Automation" custom app on the Senfa store:
#   Shopify admin > Settings > Apps and sales channels > Develop apps >
#   Senfa Automation > API credentials
# Client ID / secret are used with the client_credentials grant by
# scripts/shopify_admin.sh, so no manual token handling is needed.

SHOPIFY_STORE_DOMAIN=0pjcz9-vg.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin GraphQL API version used by scripts/shopify_admin.sh.
# Check supported versions with:
#   scripts/shopify_admin.sh 'query { publicApiVersions { handle supported } }'
SHOPIFY_API_VERSION=2026-07
